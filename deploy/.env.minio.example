# deploy/.env.minio — copiar a .env.minio y completar. NO se commitea.
#
# Lo consumen el contenedor de MinIO y el one-shot `miniosetup`, que crea los
# buckets y el usuario acotado de la app.

# Credenciales ROOT de MinIO. Solo las usa el contenedor y el setup; la app
# NUNCA las usa (tiene su propio usuario, abajo).
#   generar: openssl rand -base64 24
MINIO_ROOT_USER=countrify-root
MINIO_ROOT_PASSWORD=

# URL PUBLICA de MinIO. Tiene que ser identica a S3_ENDPOINT en .env.app y a
# FILES_DOMAIN en .env (con https://). Si los tres no coinciden al caracter, la
# firma de las URLs prefirmadas no valida y cada subida desde el navegador
# falla con SignatureDoesNotMatch.
MINIO_SERVER_URL=https://archivos.countrify.com.ar
MINIO_BROWSER_REDIRECT_URL=https://archivos.countrify.com.ar/console

# Los dos buckets. Mismos valores que S3_PUBLIC_BUCKET / S3_PRIVATE_BUCKET
# en .env.app.
S3_PUBLIC_BUCKET=countrify-public
S3_PRIVATE_BUCKET=countrify-private

# Usuario de la app: el que va en S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY de
# .env.app. `miniosetup` lo crea con una policy acotada a esos dos buckets, no
# con `readwrite` (que daria acceso a todos los buckets del servidor, incluidos
# los de Citify cuando se sume).
#   generar el secret: openssl rand -base64 32
S3_ACCESS_KEY_ID=countrify-app
S3_SECRET_ACCESS_KEY=

# Origen del navegador, para la regla de CORS de los buckets. Sin esto el
# preflight mata los 4 uploads.
APP_ORIGIN=https://countrify.com.ar
