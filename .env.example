# ===========================================================================
# Countrify — variables de entorno
# ===========================================================================
#
# Este archivo es la referencia de TODAS las variables que lee el proyecto
# (salidas de un grep de process.env sobre el repo). Copialo segun el caso:
#
#   desarrollo local  ->  .env.local        (Next lo carga solo)
#   VPS / produccion  ->  deploy/.env.app   (lo lee el contenedor por env_file)
#
# Ninguno de los dos se commitea (.gitignore los cubre).
#
# Leyenda:
#   [OBLIGATORIA]  sin esto la app no arranca o rompe una funcionalidad entera
#   [OPCIONAL]     tiene default razonable en el codigo
#   [LEGACY]       quedo de la epoca AWS; se va cuando termine la migracion
#
# ---------------------------------------------------------------------------
# SECRETOS A GENERAR (no se piden a nadie, se generan una vez y se guardan)
# ---------------------------------------------------------------------------
#   APP_SESSION_SECRET   openssl rand -base64 48
#   CRON_SECRET          openssl rand -hex 32
#   passwords de Postgres
#                        openssl rand -base64 24
#   par VAPID (push)     node -e "console.log(require('web-push').generateVAPIDKeys())"
#                        (web-push ya es dependencia del proyecto; tambien sirve
#                         npx web-push generate-vapid-keys)
#
# Rotar APP_SESSION_SECRET invalida todas las sesiones abiertas (la cookie
# countrify_session esta firmada con HMAC sobre ese valor). Rotar el par VAPID
# obliga a REBUILDEAR la imagen: la clave publica se congela en el bundle de
# cliente (ver el comentario del Dockerfile).
# ===========================================================================


# ---------------------------------------------------------------------------
# Servidor y URLs publicas
# ---------------------------------------------------------------------------

# [OPCIONAL] Next las define solas; el Dockerfile ya las fija en la imagen.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# [OBLIGATORIA] URL publica del sitio. La usan metadata/OpenGraph (app/layout),
# sitemap.ts, robots.ts, los links de los mails y el reset de password.
# Con dominio propio: https://countrify.com.ar — mientras tanto, la IP del VPS.
# Sin ella el codigo cae a http://localhost:3000 y los mails salen con links
# rotos.
# OJO: pese al prefijo NEXT_PUBLIC_, hoy solo se usa en codigo de servidor, y el
# Dockerfile NO la pasa como ARG justamente para que se pueda cambiar sin
# rebuildear. No la definas en el entorno del build.
NEXT_PUBLIC_SITE_URL=https://countrify.com.ar

# [OBLIGATORIA] Base para los links absolutos que genera el backoffice iadmin
# (liquidaciones compartidas, planilla). Normalmente el mismo valor que
# NEXT_PUBLIC_SITE_URL. Si queda vacia, esos links salen relativos y no sirven
# pegados en un WhatsApp.
NEXT_PUBLIC_APP_BASE_URL=https://countrify.com.ar

# [OBLIGATORIA] Firma de la cookie de sesion (countrify_session).
# Generar: openssl rand -base64 48
APP_SESSION_SECRET=


# ---------------------------------------------------------------------------
# Base de datos (Postgres)
# ---------------------------------------------------------------------------
# En el VPS, el host es el NOMBRE DEL SERVICIO de compose, no localhost: los
# contenedores se ven entre si por la red de compose y Postgres no publica
# puerto al host a proposito.

# [OBLIGATORIA]
DB_HOST=postgres
DB_PORT=5432
DB_NAME=countrify
DB_USER=countrify_app
DB_PASSWORD=

# [OBLIGATORIA en el VPS] TLS contra Postgres.
#
#   *** El unico valor que APAGA TLS es el literal `disable`. ***
#
# lib/db/postgres.ts, en getPoolConfig(), hace `process.env.DB_SSL === 'disable' ? false : {...}`:
# cualquier otro valor, y tambien la variable AUSENTE, intenta TLS. Contra el
# Postgres del compose (que no tiene TLS) eso falla con un mensaje que parece un
# problema de red ("connection terminated unexpectedly" / ECONNRESET) y se
# pierden horas buscando el firewall equivocado.
#
# En el VPS el trafico app<->base no sale del host, asi que `disable` esta bien.
DB_SSL=disable

# [OPCIONAL] Pool. Defaults: 10 / 30000 / 30000.
# DB_POOL_MAX tiene que entrar en max_connections de Postgres (50 en el compose).
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=30000

# [OPCIONAL] Migraciones. scripts/db/migrate.mjs corre DDL, o sea que necesita
# el rol DUENO del schema, no el de runtime. Con estas dos pisa DB_USER /
# DB_PASSWORD sin tocar el resto del entorno. Mejor pasarlas en la linea del
# comando (docker compose run -e ...) que dejarlas en el env de la app.
# DB_ADMIN_USER=countrify_admin
# DB_ADMIN_PASSWORD=

# [LEGACY] Alias que todavia leen dos scripts viejos de la era RDS
# (scripts/apply-rds-schema.js, scripts/seed-cobranzas-demo.js) como fallback de
# DB_USER. La app no la usa. No hace falta definirla.
# DB_USERNAME=


# ---------------------------------------------------------------------------
# Autenticacion
# ---------------------------------------------------------------------------
# Ya no hay Cognito: el login valida contra countrify.profiles con hash argon2id
# (lib/auth/password.ts). La unica variable de auth es APP_SESSION_SECRET, que
# esta mas arriba.
#
# El primer super_admin no se crea solo — no hay panel de AWS donde darlo de
# alta. Se siembra con scripts/db/seed-superadmin.mjs (ver el bloque del final).


# ---------------------------------------------------------------------------
# Almacenamiento de archivos (S3-compatible: Cloudflare R2 o MinIO)
# ---------------------------------------------------------------------------
# Logos de negocios, imagenes de promociones, fotos del marketplace y —lo
# importante— los comprobantes de pago de expensas y los documentos de gastos
# (countrify.iadmin_payment_claims.document_object_key y
#  countrify.iadmin_expense_documents.storage_path).
#
# Son DOS buckets: el publico se lee anonimo por HTTP, el privado solo por URL
# prefirmada. Detalle completo (crear buckets, CORS, dominio) en docs/STORAGE.md.

# [OBLIGATORIA] Endpoint S3. Tiene que ser el hostname PUBLICO, el mismo con el
# que va a pegar el navegador: la firma se calcula sobre ese host, y si aca
# pusieramos el nombre interno del contenedor los PUT desde el browser dan 403
# SignatureDoesNotMatch.
#   R2:    https://<account-id>.r2.cloudflarestorage.com
#   MinIO: https://archivos.countrify.com.ar
S3_ENDPOINT=

# [OPCIONAL] Default 'auto'. R2 usa 'auto'; en MinIO cualquier valor sirve
# mientras sea siempre el mismo (us-east-1 es lo convencional).
S3_REGION=auto

# [OBLIGATORIA] R2: token de R2 > Manage API Tokens, permiso Object Read & Write
# acotado a los dos buckets. MinIO: usuario creado con `mc admin user add`,
# nunca las credenciales root.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# [OBLIGATORIA] Los dos buckets. El privado no lleva dominio publico ni lectura
# anonima: ahi viven los comprobantes del consorcio.
S3_PUBLIC_BUCKET=countrify-public
S3_PRIVATE_BUCKET=countrify-private

# [OBLIGATORIA] Base de las URLs publicas; se le concatena la key tal cual.
# Sin barra final. R2: el custom domain del bucket publico (o el pub-*.r2.dev de
# prueba). MinIO: el dominio por el que lo publica el proxy.
S3_PUBLIC_BASE_URL=https://archivos.countrify.com.ar

# AWS_REGION=us-east-1


# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# [OPCIONAL] 'resend' | 'ses'. Si se omite, usa Resend cuando hay RESEND_API_KEY
# SES ya no existe (se fue con la cuenta AWS). Resend es el unico proveedor.
EMAIL_PROVIDER=resend

# [OBLIGATORIA para mandar mails] API key del dashboard de Resend.
RESEND_API_KEY=

# [OBLIGATORIA] Remitente verificado. El dominio tiene que estar verificado en
# Resend con sus registros SPF/DKIM — los mismos que ya se cargaron en el DNS.
RESEND_FROM_ADDRESS=Countrify <noreply@countrify.com.ar>

# [OPCIONAL] Fallbacks de remitente que lee lib/email/resend.ts en este orden:
# EMAIL_FROM_ADDRESS -> RESEND_FROM_ADDRESS. Con
# RESEND_FROM_ADDRESS puesta no hacen falta.
# EMAIL_FROM_ADDRESS=

# [OBLIGATORIA si se usa el webhook] Secret del webhook de Resend (whsec_...).
# Verifica la firma Svix de /api/email/resend-webhook. Sin este valor el webhook
# rechaza todo (fail-closed), que es lo correcto.
RESEND_WEBHOOK_SECRET=

# [SOLO DEV] Acepta webhooks sin firmar. Nunca en produccion.
# ALLOW_UNSIGNED_EMAIL_WEBHOOK=1

# [OPCIONAL] Destino del formulario de contacto de la landing.
# Default en el codigo: digitalamenitiessas@gmail.com
CONTACT_DESTINATION_EMAIL=


# ---------------------------------------------------------------------------
# Web Push (PWA)
# ---------------------------------------------------------------------------
# Par de claves VAPID. Generar UNA vez y no perderlas: si cambian, todas las
# suscripciones guardadas en la base dejan de servir y hay que volver a pedir
# permiso a cada usuario.

# [OBLIGATORIA si se usa push] mailto: de contacto que exige el estandar.
VAPID_MAILTO=mailto:admin@countrify.com.ar

# [OBLIGATORIA si se usa push] Privada: solo servidor, nunca al cliente.
VAPID_PRIVATE_KEY=

# [OBLIGATORIA si se usa push] Publica. Viaja al navegador, asi que Next la
# congela en el bundle durante el BUILD: hay que pasarla como --build-arg
# ademas de tenerla aca (la lee tambien /api/push/send del lado servidor).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# ---------------------------------------------------------------------------
# IA del backoffice (OpenRouter)
# ---------------------------------------------------------------------------
# Extraccion de datos de comprobantes, chat del backoffice y ocupacion inicial.
# Sin API key esas funciones devuelven un error claro; el resto de la app anda.

# [OPCIONAL] Key de openrouter.ai.
OPENROUTER_API_KEY=

# [OPCIONAL] Modelo del chat publico. Default: meta-llama/llama-3.3-8b-instruct:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# [OPCIONAL] Modelo de las tareas de iadmin (extraccion, anomalias).
# Default: anthropic/claude-3.5-haiku
IADMIN_AI_MODEL=anthropic/claude-3.5-haiku


# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# [OBLIGATORIA] Bearer compartido de los dos endpoints sistemicos:
#   POST /api/cron/generate-reminders     header Authorization: Bearer <valor>
#   POST /api/cron/materialize-late-fees  header X-Cron-Secret: <valor>
# Si no esta definida los endpoints devuelven 500 y los recordatorios no salen.
# Generar: openssl rand -hex 32   ·   Uso desde cron: deploy/crontab.example
CRON_SECRET=


# ===========================================================================
# Variables que NO van en el entorno de la app
# ===========================================================================
#
# scripts/db/seed-superadmin.mjs (crear el primer super_admin):
#   SEED_SUPERADMIN_EMAIL     (requerida)
#   SEED_SUPERADMIN_PASSWORD  (requerida; minimo 10 caracteres y 3 de 4 tipos)
#   SEED_SUPERADMIN_NAME      (opcional, default 'Super Admin')
#   Nunca por argumento: quedarian en el historial del shell y en `ps`.
#
# scripts/db/setup.sh (crear la base desde cero):
#   COUNTRIFY_ADMIN_PW   password del rol countrify_admin (dueno del schema)
#   COUNTRIFY_APP_PW     password del rol countrify_app (runtime; el mismo valor
#                        que DB_PASSWORD de arriba)
#   PGHOST PGPORT PGUSER PGPASSWORD   conexion del superusuario
#   En el VPS estas van en deploy/.env.dbsetup.
#
# Contenedor de Postgres (deploy/.env.db):
#   POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DB
#
# MinIO, si se usa en vez de R2 (deploy/.env.minio):
#   MINIO_ROOT_USER MINIO_ROOT_PASSWORD
#   MINIO_SERVER_URL MINIO_BROWSER_REDIRECT_URL
#
# compose (deploy/.env, valores no secretos que se interpolan en el yml):
#   COUNTRIFY_IMAGE COUNTRIFY_DB APP_BIND APP_PORT
#   COUNTRIFY_DOMAIN COUNTRIFY_TLS_EMAIL COUNTRIFY_UPSTREAM
#   NEXT_PUBLIC_VAPID_PUBLIC_KEY  (solo como --build-arg del build)
#
# deploy/backup.env: ver la cabecera de deploy/backup.sh
#
# Muertas (no las lee nada de la app):
#   AWS_COGNITO_*                  se fueron con Cognito
#   AWS_S3_BUCKET                  reemplazadas por las S3_* de arriba
#   AWS_S3_PUBLIC_BASE_URL
#   TARGET_URL, SECRET_ID          eran del Lambda de AWS (infra/lambda/)
#   NEXT_PUBLIC_SUPABASE_URL       herencia de Supabase, sin un solo uso en el
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  codigo actual
# ===========================================================================
